MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/herbera?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

# Razorpay (optional — leave empty for manual payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (optional — emails fall back to console log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@herb-era.com

# Admin credentials (auto-seeded on first run)
ADMIN_EMAIL=admin@herb-era.com
ADMIN_PASSWORD=
